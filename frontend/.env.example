# ---------------------------------------------------------------------------
# Frontend environment configuration (Create React App)
# Copy this file to frontend/.env.local for local development.
# Production values must be provided at build time.
# ---------------------------------------------------------------------------

# Backend API base URL (includes the /api suffix). REQUIRED.
# Local development:
REACT_APP_API_URL=http://localhost:5000/api
# Production example:
# REACT_APP_API_URL=https://api.example.com/api

# Razorpay publishable key (safe to expose to the browser). REQUIRED for checkout.
REACT_APP_RAZORPAY_KEY_ID=replace_with_key_id
