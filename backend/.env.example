# ---------------------------------------------------------------------------
# Backend environment configuration
# Copy this file to backend/.env and replace every placeholder.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
PORT=5000
NODE_ENV=development

# --- Database (use a dedicated non-root user in production) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=oms

# --- Auth ---
# Must be a long random value (>= 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# --- CORS / frontend ---
# Comma-separated list of trusted frontend origins. "*" is rejected in production.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_key_secret

# --- Uploads ---
# Public base URL used to build image URLs. Do not hardcode localhost in prod.
UPLOAD_BASE_URL=http://localhost:5000
# Optional: directory for stored uploads (defaults to "uploads").
# UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# Password reset delivery (required in production)
# The backend generates the OTP and stores only a bcrypt hash. A real email/SMS
# provider must deliver the code to the user. Configure a provider in production.
# ---------------------------------------------------------------------------
# RESET_DEV_LOG=true          # dev only: prints the OTP to the SERVER console
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=no-reply@example.com
# MAIL_PASSWORD=replace_with_mail_password
# MAIL_FROM=no-reply@example.com
# SMS_PROVIDER_API_KEY=replace_with_provider_key

# ---------------------------------------------------------------------------
# LLM answers (Phase 3)
# ---------------------------------------------------------------------------
# OFF by default, and opt-in per deployment. When enabled, the ADMIN assistant
# narrates the answer of the tool its own deterministic detector already chose.
# The model may never pick a different tool, and a clarification, a provider
# error, a timeout, an unsafe output or a missing key all fall back to the
# deterministic text, which stays the source of truth.
#
# The CUSTOMER assistant uses the same optional path when enabled, but only
# with its own JWT-scoped tool result; every failure still falls back to the
# deterministic answer.
#
# These are SERVER-side variables. Never prefix any of them with REACT_APP_:
# anything so named is compiled into the frontend bundle and would leak.
# ---------------------------------------------------------------------------

# Master switch. While false, no provider is constructed and no LLM call is
# made. The backend does not require an API key to start.
#
# To turn real answers on, set LLM_ENABLED=true, choose LLM_PROVIDER (openai or
# cohere) and supply LLM_API_KEY and LLM_MODEL. Do not set LLM_ENABLED=true in
# source code.
LLM_ENABLED=false

# "mock" (deterministic, no network, for tests only), "openai"
# (chat-completions compatible) or "cohere" (Cohere V2 chat API).
# Leave "mock" unset in production: it is a structural stand-in, not a real
# narrator.
LLM_PROVIDER=mock

# Server-side secret for the chosen provider. Keep out of version control.
# Never expose this to the frontend; only `hasApiKey` is ever published.
LLM_API_KEY=
LLM_MODEL=

# Optional. Overrides the provider's default endpoint. Cohere defaults to
# https://api.cohere.ai/v2 (the "/chat" path is appended automatically); OpenAI
# defaults to https://api.openai.com/v1. Only http(s) URLs are accepted, and
# https is required when NODE_ENV=production.
LLM_BASE_URL=

# Generation limits. Timeouts and iteration caps bound every run.
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=20000
LLM_MAX_TOOL_ITERATIONS=5
